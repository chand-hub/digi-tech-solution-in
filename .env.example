# =========================================================================
# DIGI TECH SOLUTION — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env for local Node development, or configure these
# exact keys as encrypted Secrets / Environment Variables in Cloudflare Pages.
# NEVER commit .env or actual secret keys to GitHub.
# =========================================================================

# Runtime & Hosting URL
NODE_ENV="development"
PORT="3000"
APP_URL="http://localhost:3000"

# Comma-separated allowed origins for CORS (e.g. https://yourdomain.com,https://your-site.pages.dev)
# Leave empty to restrict to same-origin requests in production.
ALLOWED_ORIGINS=""

# =========================================================================
# 1. RESEND TRANSACTIONAL EMAIL CONFIGURATION (SERVER-SIDE ONLY)
# =========================================================================
# Official recipient Gmail inbox for lead & enquiry notifications
OFFICIAL_NOTIFICATION_EMAIL="mdc476728@gmail.com"

# Resend API Key (starts with re_...) - get from https://resend.com/api-keys
RESEND_API_KEY=""

# Verified Sender Email (use onboarding@resend.dev for initial testing)
RESEND_FROM_EMAIL="DIGI TECH SOLUTION <onboarding@resend.dev>"

# =========================================================================
# 2. RAZORPAY PAYMENT GATEWAY (TEST MODE & LIVE MODE - SERVER-SIDE ONLY)
# =========================================================================
# Key ID: rzp_test_... for Test Mode OR rzp_live_... for Live Mode
RAZORPAY_KEY_ID=""

# Key Secret (STRICTLY SERVER-SIDE - NEVER expose in VITE_* frontend env vars)
RAZORPAY_KEY_SECRET=""

# Razorpay Webhook Signing Secret (configured in Razorpay Dashboard -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=""

# =========================================================================
# 3. WHATSAPP BUSINESS CLOUD API (OPTIONAL - SERVER-SIDE ONLY)
# If left empty, the site safely uses direct wa.me customer chat links.
# =========================================================================
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_DEFAULT_TEMPLATE="hello_world"

# =========================================================================
# 4. ADMIN API SECURITY (SERVER-SIDE ONLY)
# Strong random token (e.g. openssl rand -hex 32) for /api/admin/* endpoints
# =========================================================================
ADMIN_API_KEY=""

